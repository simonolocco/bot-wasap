{
  "name": "bot_db",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:frontend",
    "build:server": "tsc",
    "build:frontend": "vite build",
    "typecheck:frontend": "tsc --noEmit -p frontend/tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "npm run db:migrate",
    "pedido": "ts-node src/pedidos.ts",
    "dev": "ts-node src/index.ts",
    "cloud": "ts-node src/index.ts",
    "admin": "ts-node src/index.ts",
    "worker": "ts-node src/worker/index.ts",
    "db:migrate": "ts-node src/migrate.ts",
    "db:import-legacy": "ts-node scripts/importLegacy.ts",
    "password:hash": "ts-node scripts/hashPassword.ts",
    "test:load": "ts-node scripts/loadWebhook.ts",
    "test:scale": "ts-node scripts/testScale.ts",
    "test:unit": "npm run test:bot && npm run test:tickets && ts-node scripts/testUnit.ts",
    "test:integration": "ts-node scripts/testIntegration.ts",
    "test:e2e": "playwright test tests/e2e.spec.ts --project=chromium",
    "test:visual": "playwright test tests/visual.spec.ts",
    "test:security": "npm audit --audit-level=low",
    "test:qa": "npm run build && npm run test:security && npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:visual && npm run test:load",
    "qa:up": "docker compose -f docker-compose.yml -f docker-compose.qa.yml up -d --build",
    "qa:down": "docker compose -f docker-compose.yml -f docker-compose.qa.yml down -v",
    "test:tickets": "ts-node scripts/testTickets.ts",
    "test:bot": "ts-node scripts/testBotFlows.ts",
    "test:frontend": "npm run typecheck:frontend",
    "ngrok": "ts-node scripts/runNgrok.ts",
    "embeddings": "ts-node scripts/generateEmbeddings.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@google/generative-ai": "^0.24.1",
    "@ngrok/ngrok": "^1.6.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "chokidar": "^4.0.3",
    "connect-pg-simple": "^10.0.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "express-async-errors": "^3.1.1",
    "express-session": "^1.19.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/chokidar": "^1.7.5",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.9.1",
    "@types/pg": "^8.21.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1"
  },
  "overrides": {
    "path-to-regexp": "0.1.13",
    "diff": "4.0.4",
    "uuid": "11.1.1"
  }
}
