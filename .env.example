# Public hostname pointing by DNS A record to the VPS public IP.
# It can be a hostname provided by a free DNS service such as DuckDNS.
PUBLIC_DOMAIN=abastobot.example.com
# Immutable release identifiers used by Docker Compose and rollback.
APP_IMAGE_TAG=qa-hardening-YYYYMMDD-HHMM
POSTGRES_IMAGE_TAG=walg-3.0.8

POSTGRES_DB=abastobot
POSTGRES_USER=abastobot
POSTGRES_PASSWORD=replace_with_a_long_random_database_password

# WhatsApp / Meta
META_VERIFY_TOKEN=replace_with_a_random_verify_token
META_APP_SECRET=your_meta_app_secret
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_CLOUD_TOKEN=your_long_lived_cloud_token
# Local/staging defaults to mock even if the real token is present. Use cloud only in production or explicitly.
WHATSAPP_TRANSPORT=mock
ALLOW_LIVE_WHATSAPP=false
ALLOW_UNSIGNED_WEBHOOKS=false
WHATSAPP_HTTP_TIMEOUT_MS=15000
MOCK_OUTBOUND_LOG=storage/mock-outbound.jsonl
# Set to "off" only for load tests; messages remain verifiable in PostgreSQL.
MOCK_WHATSAPP_DELAY_MS=0
MOCK_WHATSAPP_FAILURE_MODE=
FORWARD_ORDER_NUMBER=5493510000000
# Approved Meta template used when the 24-hour WhatsApp window has expired.
# Its body should accept {{1}} as the order continuation link.
ORDER_FALLBACK_TEMPLATE_NAME=
ORDER_FALLBACK_TEMPLATE_LANGUAGE=es_AR

# Administrator: create the hash with npm run password:hash -- "your password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
SESSION_SECRET=replace_with_at_least_32_random_characters

PORT=4002
WORKER_CONCURRENCY=16
WORKER_POLL_MS=250
DB_POOL_MAX=20
MEDIA_STORAGE_PATH=/app/storage/media
# Use "s3" in production. Files remain private and the local volume acts as a cache.
MEDIA_STORAGE_DRIVER=s3
MEDIA_S3_BUCKET=abastobot-media
MEDIA_S3_ENDPOINT=https://s3.example.com
MEDIA_S3_PREFIX=abastobot/media
MEDIA_S3_FORCE_PATH_STYLE=false
AUTO_RESPONSE_MAX_DELAY_SECONDS=120
# Avoid repeating an automatic reply when the same inbound text arrives twice quickly.
DUPLICATE_AUTO_RESPONSE_WINDOW_SECONDS=90

# S3-compatible backup storage (private bucket)
BACKUP_S3_BUCKET=abastobot-backups
BACKUP_S3_ENDPOINT=https://s3.example.com
AWS_ACCESS_KEY_ID=replace_with_backup_access_key
AWS_SECRET_ACCESS_KEY=replace_with_backup_secret
AWS_DEFAULT_REGION=auto
AWS_S3_FORCE_PATH_STYLE=false
# Keep the two newest physical backups; WAL-G removes only older recovery chains.
WALG_RETAIN_FULL_BACKUPS=2

# PostgreSQL continuous archive. Keep off locally; production must use the wal-g command below.
POSTGRES_ARCHIVE_MODE=on
POSTGRES_ARCHIVE_COMMAND=wal-g wal-push %p
POSTGRES_ARCHIVE_TIMEOUT=300s
