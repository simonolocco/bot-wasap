# Copiar las variables necesarias a .env.local. No copiar credenciales de WhatsApp ni DATABASE_URL.
NODE_ENV=development
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.5-flash-lite
AI_PREVIEW_PORT=4010
# El simulador no necesita habilitar el worker.
AI_ASSISTANT_ENABLED=false
# Para worker de desarrollo, habilitar sólo contra una base y número de prueba.
AI_CATALOG_PATH=storage/ai-preview/catalog.json
CATALOG_MAYORISTA_URL=
CATALOG_MINORISTA_URL=
